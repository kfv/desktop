+	/*
+	 * The percentage while running on battery, and empty on AC power or
+	 * where there is no AC adapter to ask, so the entry is left out.
+	 */
+	const char *
+	battery_unplugged(const char *unused)
+	{
+		int acline;
+		size_t len;
+
+		len = sizeof(acline);
+		if (sysctlbyname(AC_LINE, &acline, &len, NULL, 0) < 0 || !len
+		    || acline)
+			return "";
+
+		return battery_perc(unused);
