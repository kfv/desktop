 #define STRING_WIDTH(f, s) 	TEXT_WIDTH (f, s, strlen(s))
+
+/*
+ * The password echo character as one UTF-8 character, such as U+2022,
+ * or 0 to use its first byte as before.  The value text itself stays
+ * Latin-1, so only the echo is drawn this way.
+ */
+static unsigned long
+EchoChar (LoginWidget w)
+{
+#ifdef USE_XFT
+    const char *s = w->login.echo_passwd_char;
+    FcChar32 c;
+
+    if (s != NULL && *s != '\0' &&
+	FcUtf8ToUcs4 ((const FcChar8 *) s, &c, strlen (s)) > 0)
+	return c;
+#endif
+    return 0;
+}
+
+/* Width of len bytes of a value, or of len echo characters. */
+static int
+ValueWidth (LoginWidget w, unsigned long echo, const char *s, int len)
+{
+#ifdef USE_XFT
+    if (echo) {
+	FcChar32 c = echo;
+	XGlyphInfo extents;
+
+	XftTextExtents32 (XtDisplay (w), w->login.textFace, &c, 1, &extents);
+	return len * extents.xOff;
+    }
+#endif
+    return TEXT_WIDTH (text, s, len);
+}
+
+static void
+DrawValueText (LoginWidget w, unsigned long echo, int x, int y,
+	       const char *s, int len)
+{
+#ifdef USE_XFT
+    if (echo) {
+	FcChar32 *buf;
+	int i;
 
+	if (len <= 0)
+	    return;
+	buf = (FcChar32 *) XtMalloc (len * sizeof (*buf));
+	for (i = 0; i < len; i++)
+	    buf[i] = echo;
+	XftDrawString32 (w->login.draw, &w->login.textcolor,
+			 w->login.textFace, x, y, buf, len);
+	XtFree ((char *) buf);
+	return;
+    }
+#endif
+    DRAW_STRING (text, x, y, s, len);
+}
+
