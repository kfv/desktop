--- config.def.h.orig
+++ config.def.h
@@ -2,11 +2,20 @@
 static const char *user  = "nobody";
 static const char *group = "nogroup";
 
+/* the lock is a grid of dots, one every dotgap pixels, on background */
+static const char *background = "#000000";
+static const unsigned int dotgap = 28;
+
 static const char *colorname[NUMCOLS] = {
-	[INIT] =   "black",     /* after initialization */
-	[INPUT] =  "#005577",   /* during input */
+	[INIT] =   "#8C3A3A",   /* after initialization */
+	[INPUT] =  "#D46A6A",   /* during input */
 	[FAILED] = "#CC3333",   /* wrong password */
 };
 
+/* join the dots into dotted vertical lines, bars, in these states */
+static const int bars[NUMCOLS] = {
+	[FAILED] = 1,
+};
+
 /* treat a cleared input like a wrong password (color) */
-static const int failonclear = 1;
+static const int failonclear = 0;
--- slock.c.orig
+++ slock.c
@@ -36,6 +36,7 @@
 	int screen;
 	Window root, win;
 	Pixmap pmap;
+	Pixmap tiles[NUMCOLS];
 	unsigned long colors[NUMCOLS];
 };
 
@@ -194,9 +195,9 @@
 			color = len ? INPUT : ((failure || failonclear) ? FAILED : INIT);
 			if (running && oldc != color) {
 				for (screen = 0; screen < nscreens; screen++) {
-					XSetWindowBackground(dpy,
-					                     locks[screen]->win,
-					                     locks[screen]->colors[color]);
+					XSetWindowBackgroundPixmap(dpy,
+					                           locks[screen]->win,
+					                           locks[screen]->tiles[color]);
 					XClearWindow(dpy, locks[screen]->win);
 				}
 				oldc = color;
@@ -232,6 +233,8 @@
 	XColor color, dummy;
 	XSetWindowAttributes wa;
 	Cursor invisible;
+	GC gc;
+	unsigned int y;
 
 	if (dpy == NULL || screen < 0 || !(lock = malloc(sizeof(struct lock))))
 		return NULL;
@@ -243,18 +246,39 @@
 		XAllocNamedColor(dpy, DefaultColormap(dpy, lock->screen),
 		                 colorname[i], &color, &dummy);
 		lock->colors[i] = color.pixel;
+	}
+
+	/*
+	 * One tile per state: background with a single dot at its origin,
+	 * or, for bars, a dot on every other pixel down its left edge; a solid
+	 * 1px line reads heavier than the grid around it.  The lock window
+	 * sits at the root origin, so the grid lines up with a root window
+	 * tiled the same way.
+	 */
+	XAllocNamedColor(dpy, DefaultColormap(dpy, lock->screen),
+	                 background, &color, &dummy);
+	gc = XCreateGC(dpy, lock->root, 0, NULL);
+	for (i = 0; i < NUMCOLS; i++) {
+		lock->tiles[i] = XCreatePixmap(dpy, lock->root, dotgap, dotgap,
+		                               DefaultDepth(dpy, lock->screen));
+		XSetForeground(dpy, gc, color.pixel);
+		XFillRectangle(dpy, lock->tiles[i], gc, 0, 0, dotgap, dotgap);
+		XSetForeground(dpy, gc, lock->colors[i]);
+		for (y = 0; y < (bars[i] ? dotgap : 1); y += 2)
+			XDrawPoint(dpy, lock->tiles[i], gc, 0, y);
 	}
+	XFreeGC(dpy, gc);
 
 	/* init */
 	wa.override_redirect = 1;
-	wa.background_pixel = lock->colors[INIT];
+	wa.background_pixmap = lock->tiles[INIT];
 	lock->win = XCreateWindow(dpy, lock->root, 0, 0,
 	                          DisplayWidth(dpy, lock->screen),
 	                          DisplayHeight(dpy, lock->screen),
 	                          0, DefaultDepth(dpy, lock->screen),
 	                          CopyFromParent,
 	                          DefaultVisual(dpy, lock->screen),
-	                          CWOverrideRedirect | CWBackPixel, &wa);
+	                          CWOverrideRedirect | CWBackPixmap, &wa);
 	lock->pmap = XCreateBitmapFromData(dpy, lock->win, curs, 8, 8);
 	invisible = XCreatePixmapCursor(dpy, lock->pmap, lock->pmap,
 	                                &color, &color, 0, 0);
