+/*
+ * Shrink a tiled window's cell by gappx at the monitor's edges and by
+ * half of it on each side between cells, so that every gap is gappx.
+ */
 void
+tilegap(Client *c, int *x, int *y, int *w, int *h)
+{
+	Monitor *m = c->mon;
+	int l, r, t, b;
+
+	l = *x == m->wx ? gappx : gappx / 2;
+	t = *y == m->wy ? gappx : gappx / 2;
+	r = *x + *w + 2 * c->bw == m->wx + m->ww ? gappx : gappx - gappx / 2;
+	b = *y + *h + 2 * c->bw == m->wy + m->wh ? gappx : gappx - gappx / 2;
+	*x += l;
+	*y += t;
+	*w -= l + r;
+	*h -= t + b;
+}
