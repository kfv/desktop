+/*
+ * The mouse wheel: through the history on the normal screen, and as ^Y
+ * and ^E to the program on the alternate one, as without scrollback.
+ */
 void
+wheelscroll(const Arg *a)
+{
+	Arg n = { .i = a->i > 0 ? a->i : -a->i };
+
+	if (IS_SET(MODE_ALTSCREEN))
+		ttywrite(a->i > 0 ? "\031" : "\005", 1, 1);
+	else if (a->i > 0)
+		kscrollup(&n);
+	else
+		kscrolldown(&n);
+}
